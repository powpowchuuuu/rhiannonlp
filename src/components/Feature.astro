---
/* One idea per section: a short title, a paragraph or two, a screenshot.
   `flip` puts the image on the left. */
import PhoneShot from "./PhoneShot.astro";

interface Props {
  title: string;
  eyebrow?: string;
  shot?: string;
  shotAlt?: string;
  flip?: boolean;
}

const { title, eyebrow, shot, shotAlt, flip = false } = Astro.props;
---

<section class:list={["feature", { flip }]}>
  <div class="wrap grid">
    <div class="text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      <div class="body muted"><slot /></div>
    </div>
    <PhoneShot src={shot} alt={shotAlt} width={300} class="image" />
  </div>
</section>

<style>
  .feature {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .text {
    display: grid;
    gap: 1.25rem;
    max-width: var(--measure);
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
  }

  .body {
    display: grid;
    gap: 0.9rem;
    font-size: 1.125rem;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 1fr auto;
      gap: clamp(2.5rem, 8vw, 6rem);
    }

    .flip .grid {
      grid-template-columns: auto 1fr;
    }

    .flip .text {
      order: 2;
    }
  }
</style>
