---
/* One idea per section, nowplaying.co style: a big accent heading, a short
   paragraph on a narrow measure, then a wide image with no frame. */
import Shot from "./Shot.astro";

interface Props {
  id?: string;
  title: string;
  shot?: string;
  shotAlt?: string;
}

const { id, title, shot, shotAlt } = Astro.props;
---

<section class="feature" id={id}>
  <div class="wrap">
    <h2>{title}</h2>
    <div class="body measure"><slot /></div>
    <Shot src={shot} alt={shotAlt} class="image" />
  </div>
</section>

<style>
  .feature {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .wrap {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  h2 {
    color: var(--accent);
  }

  .body {
    display: grid;
    gap: 0.9rem;
    font-size: 1.125rem;
  }

  .wrap :global(.image) {
    margin-top: clamp(1.5rem, 5vw, 3rem);
    max-width: 56rem;
  }
</style>
