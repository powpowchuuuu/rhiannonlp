---
/* One idea per section, nowplaying.co style: a big accent heading, a short
   paragraph on a narrow measure, then media with no frame. Put images in the
   `media` slot; without it, a wide placeholder is drawn. */
import Shot from "./Shot.astro";

interface Props {
  id?: string;
  title: string;
  wide?: boolean;
}

const { id, title, wide = false } = Astro.props;
const hasMedia = Astro.slots.has("media");
---

<section class="feature" id={id}>
  <div class="wrap">
    <h2 class:list={{ wide }}>{title}</h2>
    <div class="body measure"><slot /></div>
    <div class="media">
      {hasMedia ? <slot name="media" /> : <Shot />}
    </div>
  </div>
</section>

<style>
  .feature {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .wrap {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  h2 {
    color: var(--accent);
  }

  h2.wide {
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
  }

  .body {
    display: grid;
    gap: 0.9rem;
    font-size: 1.125rem;
  }

  .media {
    width: 100%;
    max-width: 56rem;
    margin-top: clamp(1.5rem, 5vw, 3rem);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(1rem, 4vw, 3rem);
  }

  .media:empty {
    display: none;
  }
</style>
