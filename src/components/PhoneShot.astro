---
/* A screenshot slot. Until real captures arrive, it renders a raised block
   at iPhone proportions; pass `src` to show the image instead. */
interface Props {
  src?: string;
  alt?: string;
  width?: number;
  class?: string;
}

const { src, alt = "", width = 320, class: className } = Astro.props;
---

<figure class:list={["shot", className]} style={`--w:${width}px`}>
  {src ? <img src={src} alt={alt} width={width} height={Math.round(width * 2.164)} loading="lazy" /> : <div class="placeholder" aria-hidden="true"></div>}
</figure>

<style>
  .shot {
    margin: 0;
    width: min(var(--w), 100%);
    aspect-ratio: 1 / 2.164;
    border-radius: var(--radius-phone);
    overflow: hidden;
    background: var(--surface-raised);
  }

  .shot img,
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
