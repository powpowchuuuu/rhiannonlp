---
/* The app's "now playing" band, in miniature. Amber is reserved for this. */
interface Props {
  title: string;
  artist: string;
}

const { title, artist } = Astro.props;
---

<p class="pill">
  <span class="dot" aria-hidden="true"></span>
  <span class="label">Now playing</span>
  <span class="track"><strong>{title}</strong> · {artist}</span>
</p>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem 0.55rem 0.85rem;
    border-radius: var(--radius-live);
    background: var(--live-surface);
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--live);
    animation: pulse 1.6s ease-in-out infinite;
  }

  .label {
    color: var(--live);
    font-weight: 600;
  }

  .track strong {
    color: var(--ink);
    font-weight: 600;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>
