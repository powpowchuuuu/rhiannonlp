---
/* An image slot. Pass an imported image (`src/assets/shots/*.png`) and it is
   resized and served as WebP by astro:assets. Without one it renders a raised
   block: `phone` for iPhone proportions, otherwise a wide 16:10 stage. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata;
  alt?: string;
  phone?: boolean;
  width?: number;
  class?: string;
}

const { src, alt = "", phone = false, width = phone ? 640 : 1400, class: className } = Astro.props;
---

<figure class:list={["shot", { phone }, className]}>
  {src ? <Image src={src} alt={alt} width={width} format="webp" quality={82} /> : <div class="placeholder" aria-hidden="true"></div>}
</figure>

<style>
  .shot {
    margin: 0;
    width: 100%;
    border-radius: var(--radius-live);
    overflow: hidden;
    background: var(--surface-raised);
  }

  .shot:not(:has(img)) {
    aspect-ratio: 16 / 10;
  }

  .phone {
    width: min(320px, 100%);
    border-radius: var(--radius-phone);
  }

  .phone:not(:has(img)) {
    aspect-ratio: 1 / 2.164;
  }

  .shot img,
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
