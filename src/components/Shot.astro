---
/* An image slot. Until the real captures arrive it renders a raised block:
   `phone` for iPhone proportions, otherwise a wide 16:10 stage for composed
   mockups. Pass `src` to show the image instead. */
interface Props {
  src?: string;
  alt?: string;
  phone?: boolean;
  class?: string;
}

const { src, alt = "", phone = false, class: className } = Astro.props;
---

<figure class:list={["shot", { phone }, className]}>
  {src ? <img src={src} alt={alt} loading="lazy" /> : <div class="placeholder" aria-hidden="true"></div>}
</figure>

<style>
  .shot {
    margin: 0;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-live);
    overflow: hidden;
    background: var(--surface-raised);
  }

  .phone {
    width: min(320px, 100%);
    aspect-ratio: 1 / 2.164;
    border-radius: var(--radius-phone);
  }

  .shot img,
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
