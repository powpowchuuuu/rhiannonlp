---
/* The app icon, clipped to the iOS squircle. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 96, class: className } = Astro.props;
---

<img
  class:list={["icon", className]}
  src="/icon.png"
  alt="Rhiannon app icon"
  width={size}
  height={size}
  style={`--s:${size}px`}
/>

<style>
  .icon {
    width: var(--s);
    height: var(--s);
    border-radius: calc(var(--s) * 0.2237);
  }
</style>
