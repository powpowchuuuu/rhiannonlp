---
import Base from "../layouts/Base.astro";
import AppStoreButton from "../components/AppStoreButton.astro";
import Shot from "../components/Shot.astro";
import Feature from "../components/Feature.astro";
import HeroStage from "../components/HeroStage.astro";
import Cloud from "../components/Cloud.astro";

import detailIphone from "../assets/shots/detail-iphone.png";
import detailIpad from "../assets/shots/detail-ipad.png";
import detailTaylor from "../assets/shots/detail-taylor-iphone.png";
import detailSabrina from "../assets/shots/detail-sabrina-iphone.png";

// TODO: replace with the App Store (or TestFlight) link once the app is listed.
const APP_STORE_URL = "#";
const year = new Date().getFullYear();

const keeps = [
  "Journal",
  "Tops",
  "Lyrics",
  "Album pages",
  "Artist pages",
  "Love",
  "Review queue",
  "Last.fm",
  "ListenBrainz",
  "Play counts",
  "Background sync",
  "Widget",
  "No ads",
  "No tracking",
  "No Pro tier",
];
---

<Base
  title="Rhiannon — Apple Music scrobbler for Last.fm"
  description="Rhiannon scrobbles what you play in Apple Music to Last.fm and ListenBrainz. Free, with nothing to unlock."
>
  <header class="nav">
    <div class="wrap row">
      <a class="brand" href="/" aria-label="Rhiannon">
        <img src="/logo.svg" alt="" width="20" height="27" />
      </a>
      <nav class="links">
        <a href="#background">Background</a>
        <a href="#journal">Journal</a>
        <a href="#free">Free</a>
        <a class="get" href={APP_STORE_URL}>Get the app</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap center">
        <p class="name">Rhiannon</p>
        <h1>Every listen,<br />on Last.fm.</h1>
        <HeroStage ipad={detailIpad} iphone={detailIphone} alt="Rhiannon's track page for stupid song by Olivia Rodrigo, on iPad and iPhone" />
        <p class="lede measure">
          Rhiannon scrobbles what you play in Apple Music to Last.fm and ListenBrainz.
          Free, with nothing to unlock.
        </p>
        <AppStoreButton href={APP_STORE_URL} />
        <p class="platform faint">iPhone, iOS 26 or later. Requires a Last.fm account.</p>
      </div>
    </section>

    <section class="background" id="background">
      <div class="wrap center">
        <h2>It catches up when iOS looks away.</h2>
        <p class="lede measure">
          iOS suspends apps in the background, and a naive scrobbler loses everything that
          plays in the meantime. Rhiannon catches up when it wakes, through three separate
          sources, and reconciles them so nothing is counted twice or lost.
        </p>
        <ul class="sources">
          <li>
            <strong>Play counts</strong>
            <span>What your library says you played, and when it ended.</span>
          </li>
          <li>
            <strong>Live tracking</strong>
            <span>The player itself, measured while the app is on screen.</span>
          </li>
          <li>
            <strong>Catalog history</strong>
            <span>Your Apple Music history, across all your devices.</span>
          </li>
        </ul>
        <p class="lede measure approve">
          Uncertain listens wait for your approval. Nothing goes out that you didn't agree to.
        </p>
      </div>
    </section>

    <Feature id="journal" title="A journal, not a feed.">
      <p>
        Your listens, day by day, with artwork, in the order you heard them. Runs of the
        same artist fold under a fan of covers. Tap a track for its page.
      </p>
    </Feature>

    <Feature title="A page behind every track.">
      <p>
        Full-bleed artwork, and a page that takes its colours. Release details, Last.fm
        listener counts, tags, the story behind the song, and the lyrics.
      </p>
      <Fragment slot="media">
        <Shot phone src={detailTaylor} alt="Track page for I Knew It, I Knew You by Taylor Swift" />
        <Shot phone src={detailSabrina} alt="Track page for House Tour by Sabrina Carpenter" />
      </Fragment>
    </Feature>

    <Cloud words={keeps} shotAlt="Rhiannon on iPhone" />

    <section class="free" id="free">
      <div class="wrap center">
        <h2>Free. Really.</h2>
        <p class="lede measure">
          Background scrobbling, ListenBrainz, the home screen widget: the things other
          scrobblers sell as Pro, Rhiannon just does. No subscription, no ads, no tracking,
          no account beyond your Last.fm, which is free too.
        </p>
        <AppStoreButton href={APP_STORE_URL} />
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap row">
      <p class="faint">© {year} Rhiannon</p>
      <p class="faint">Powered by AudioScrobbler. Not affiliated with Apple, Last.fm, or ListenBrainz.</p>
    </div>
  </footer>
</Base>

<style>
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .center {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  /* Sticky, blurred, like nowplaying.co. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: 0.9rem;
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    color: var(--ink);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.5vw, 1.5rem);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .links a {
    color: var(--ink);
  }

  .links a:not(.get) {
    display: none;
  }

  @media (min-width: 40rem) {
    .links a:not(.get) {
      display: inline;
    }
  }

  .get {
    padding: 0.55rem 1rem;
    border-radius: var(--radius-round);
    background: var(--accent);
    color: var(--accent-ink) !important;
  }

  .get:hover {
    text-decoration: none;
    opacity: 0.92;
  }

  .hero {
    padding-block: clamp(3rem, 8vw, 5rem) 0;
  }

  .name {
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: -1rem;
  }

  .hero h1 {
    color: var(--accent);
  }

  .hero :global(.stage) {
    margin-block: clamp(1rem, 4vw, 2.5rem);
  }

  .lede {
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
  }

  .platform {
    font-size: 0.9375rem;
    margin-top: -0.5rem;
  }

  /* The strongest argument gets the most room. */
  .background {
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  .background h2 {
    color: var(--accent);
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
  }

  .sources {
    list-style: none;
    margin: clamp(1rem, 3vw, 2rem) 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    width: 100%;
    max-width: 52rem;
  }

  .sources li {
    display: grid;
    gap: 0.35rem;
  }

  .sources strong {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .sources span {
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .sources {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .approve {
    color: var(--ink);
    font-weight: 600;
  }

  .free {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .free h2 {
    color: var(--accent);
    font-size: clamp(2.5rem, 7vw, 4rem);
  }

  .foot {
    padding-block: 2rem 3rem;
    font-size: 0.875rem;
  }

  .foot .row {
    flex-wrap: wrap;
  }
</style>
